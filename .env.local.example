# Supabase project: ph-clinic-saas (ap-southeast-1)
# Copy this file to .env.local for local dev, and set the same values as
# Environment Variables in the Vercel project settings (Project Settings →
# Environment Variables). NEVER commit real values for the server-only
# keys below — get them from the Supabase / PayMongo dashboards directly
# and paste them straight into Vercel, not into this file or into chat.

NEXT_PUBLIC_SUPABASE_URL=https://pfoeuildrnlrrmjvwoss.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_9EWzA_uQcz2FyIevvbmS9Q_98zCCJW4

# SERVER-ONLY. Powers "Invite staff" on a client's admin page (creates the
# login + sends Supabase's built-in invite email). Get it from Supabase
# dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY. Powers "Get PayMongo link" on an invoice. Get it from your
# PayMongo dashboard → Developers → API Keys → Secret key.
PAYMONGO_SECRET_KEY=

# SERVER-ONLY, optional but recommended. Get it after registering the
# webhook endpoint (https://<your-domain>/api/webhooks/paymongo) in
# PayMongo dashboard → Developers → Webhooks. Without this set, incoming
# webhook payloads are trusted without signature verification.
PAYMONGO_WEBHOOK_SECRET=
